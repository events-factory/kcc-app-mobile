*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
config.bat

# --- env files (ensure-env-gitignored.sh) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template

